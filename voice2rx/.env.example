# Voice2Rx local configuration. Copy to voice2rx/.env (never commit .env).
PORT=8787

# --- Speech-to-text (local Whisper via faster-whisper) ---
WHISPER_PYTHON=python3
WHISPER_MODEL=base          # tiny | base | small | medium
WHISPER_LANGUAGE=           # empty = auto-detect, e.g. en
MAX_AUDIO_MB=50

# --- Structured extraction (local LLM through Ollama) ---
LLM_PROVIDER=ollama         # ollama | basic (rule-based only)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# --- Persistence (local JSON file, dev only) ---
DATA_FILE=server/data/consultations.json
