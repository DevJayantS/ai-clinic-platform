# Patient Medical Document Search System - Environment Configuration Example
# Copy this file to .env and adjust variables as required.

# Database URL (Defaults to SQLite in local storage directory)
# For future PostgreSQL integration: postgresql://user:password@localhost:5432/clinic_os
DATABASE_URL=sqlite:///storage/patient_search.db

# Storage Directory for uploaded medical records
STORAGE_DIR=storage/documents

# Maximum allowed file upload size in bytes (Default: 25MB = 26214400)
MAX_UPLOAD_SIZE_BYTES=26214400

# OCR Settings
# Path to Tesseract OCR executable on Windows if not in PATH
# Typical Windows path: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
ENABLE_OCR=true
